+
+void OpcTcpConnection::AflLoopBody()
+{
+  try {
+    // 1) Read header
+    std::size_t hdrSz = GetHeaderSize();
+    boost::asio::read(Socket, boost::asio::buffer(Buffer.data(), hdrSz));
+    OpcUa::InputFromBuffer hdrBuf(Buffer.data(), hdrSz);
+    IStreamBinary hdrIn(hdrBuf);
+    OpcUa::Binary::Header header;
+    hdrIn >> header;
+
+    // Print the header
+    printf("Received header: Type: %d, ChunkType: %d, Size: %d\n", header.Type, header.Chunk, header.Size);
+
+    // 2) Read body
+    std::size_t bodySz = header.Size - hdrSz;
+    if (bodySz > Buffer.size())
+    {
+      Buffer.resize(bodySz);
+    }
+    boost::asio::read(Socket, boost::asio::buffer(Buffer.data(), bodySz));
+
+    // Print the body
+    printf("Received body: %s\n", Buffer.data());
+
+    // 3) Dispatch
+    OpcUa::InputFromBuffer msgBuf(Buffer.data(), bodySz);
+    IStreamBinary msgIn(msgBuf);
+    try {
+      bool cont = MessageProcessor->ProcessMessage(header.Type, msgIn);
+      // Print continue or not
+      printf("Continue: %d\n", cont);
+    } catch (...) {
+        // If an exception occurs, a response will not be sent. We force a response with an error.
+        printf("Sending an error\n");
+        MessageProcessor->SendError();
+    }
+  } catch (...) {
+    printf("Sending an error, but the message is not invalid\n");
+    MessageProcessor->SendError();
+  }
+}
